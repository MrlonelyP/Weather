# Copy to .env and adjust.  Never commit .env (it holds keys).

# --- Core ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://flood:flood@localhost:5432/flood_intel
LOG_LEVEL=INFO
# true = run the scheduler inside the API process (dev). Production: run
# `python -m app.scheduler` as a separate process and keep this false.
RUN_SCHEDULER_IN_API=false

# --- HTTP (all collectors) ---------------------------------------------
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=2
HTTP_BACKOFF_MAX_SECONDS=60
HTTP_USER_AGENT=ThailandWeatherFloodIntel-Phase0/0.1

# --- Health ------------------------------------------------------------
HEALTH_UNAVAILABLE_AFTER_FAILURES=3
HEALTH_STALE_FACTOR=3

# --- Open-Meteo (WX-01..04) - no key needed for non-commercial use -------
OPENMETEO_ENABLED=true
# Commercial use requires a key; when set, customer-* hosts are used.
OPENMETEO_API_KEY=
OPENMETEO_POLL_MINUTES=30
OPENMETEO_FORECAST_DAYS=16
OPENMETEO_HISTORICAL_ENABLED=true
OPENMETEO_HISTORICAL_LOOKBACK_DAYS=3
# Model list (JSON). meta_id = model-update metadata id giving the run time.
# Verify these ids on first real run (see docs/DATA_SOURCES.md).
# OPENMETEO_MODELS=[{"name":"ECMWF","endpoint":"ecmwf","param":"ecmwf_ifs","meta_id":"ecmwf_ifs","extra_hourly":["soil_moisture_0_to_7cm"]},{"name":"GFS","endpoint":"gfs","param":"gfs_global","meta_id":"ncep_gfs013","extra_hourly":["soil_moisture_0_to_10cm"]},{"name":"JMA","endpoint":"jma","param":"jma_gsm","meta_id":"jma_gsm"}]

# --- TMD telecom API (TMD-01..03) - public -------------------------------
TMD_ENABLED=true
TMD_BASE_URL=https://telecom.tmd.go.th/api/ftp
# Query parameter names/format - confirm against https://telecom.tmd.go.th/api-docs
TMD_PARAM_DATE=date
TMD_PARAM_COUNTRY=country
TMD_PARAM_UTC=utc
TMD_DATE_FORMAT=%Y-%m-%d
TMD_COUNTRY=TH
TMD_SYNOPTIC_ENABLED=true
TMD_WARNING_ENABLED=true
TMD_METAR_ENABLED=false

# --- RID reservoir API (RID-01..02) - public -----------------------------
RID_ENABLED=true
RID_DAM_URL=https://app.rid.go.th/reservoir/api/dam/public
RID_MEDIUM_URL=https://app.rid.go.th/reservoir/api/reservoir/public
RID_MEDIUM_ENABLED=false
RID_DATE_PATH_FORMAT={url}/{date}

# --- GISTDA (GIS-01..02) - API key required ----------------------------
GISTDA_ENABLED=true
# Register at https://api-gateway.gistda.or.th  (leave empty -> status NO_API_KEY)
GISTDA_API_KEY=
GISTDA_API_KEY_HEADER=API-Key
GISTDA_POINT_CHECK_URL=https://api-gateway.gistda.or.th/api/2.0/resources/gi-service/v1.0/disasters/flood-extent-1day
GISTDA_POINT_PARAM_LAT=lat
GISTDA_POINT_PARAM_LON=lon
# GIS-02 polygon endpoint from https://disaster.gistda.or.th/services/open-api (empty -> NOT_CONFIGURED)
GISTDA_FLOOD_POLYGON_URL=

# --- Terrain / DEM (docs/TERRAIN.md) ---
# DEM_DATA_DIR=data/dem
# TERRAIN_DATASETS=copernicus_glo30,fabdem_v1_2
# fabdem_v1_2 is CC BY-NC-SA (non-commercial). Use copernicus_glo30 for a commercial deployment.
# TERRAIN_PRIMARY_DATASET=fabdem_v1_2
