# FastAPI backend (server-side only; the browser calls /api on this origin)
BACKEND_URL=http://localhost:8000
# Dashboard polling interval (ms). Polling reads our API/DB only - never source APIs.
NEXT_PUBLIC_REFRESH_MS=60000
# Basemap style (no API key). Alternatives: https://tiles.openfreemap.org/styles/dark
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
